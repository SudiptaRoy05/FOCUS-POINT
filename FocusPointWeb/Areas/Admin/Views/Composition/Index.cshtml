@model IEnumerable<Composition>
@{
    ViewData["Title"] = "Index";
}

<div class="row mt-4">
    <div class="col-6">
        <h3 class="text-primary">Composition List</h3>
    </div>
    <div class="col-6 text-end">
        <a asp-action="Create" asp-controller="Composition" class="btn btn-primary"><i class="bi bi-plus-circle"></i>&nbsp;Create Composition</a>
    </div>
</div>

<br />

<div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th width="60%">Composition Name</th>
                <th width="40%">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model)
            {
                <tr>
                    <td>@obj.Name</td>
                    <td>
                        <div class="btn-group" role="group">
                            <a asp-action="Edit" asp-controller="Composition" asp-route-Id="@obj.Id" class="btn btn-info"><i class="bi bi-pencil-square"></i>&nbsp;Edit</a>
                            <a asp-action="Delete" asp-controller="Composition" asp-route-Id="@obj.Id" class="btn btn-danger"><i class="bi bi-trash"></i>&nbsp;Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
