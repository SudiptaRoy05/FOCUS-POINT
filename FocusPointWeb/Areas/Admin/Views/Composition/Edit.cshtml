@model Composition
@{
    ViewData["Title"] = "Edit";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h3 class="text-primary text-center">Update Composition</h3>
            <form method="post" class="mt-4">
                <div class="form-group">
                    <label asp-for="Name" class="font-weight-bold">Composition Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-success">Update Category</button>
                    <a asp-action="Index" asp-controller="Composition" class="btn btn-secondary ml-3">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}