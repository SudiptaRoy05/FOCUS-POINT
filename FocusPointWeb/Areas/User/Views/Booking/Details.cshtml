@using FocusPoint.Utility;
@model FocusPoint.Models.ViewModel.BookingVM



<form method="post">
	<input asp-for="BookingHeder.Id" hidden />
	<br />
	<div class="container">
		<div class="card">
			<div class="card-header bg-dark text-light ml-0">
				<div class="container row">
					<div class="col-12 d-none d-md-block col-md-6 pb-1">
						<i class="fas fa-shopping-cart"></i> &nbsp; Order Summary
					</div>
					<div class="col-12 col-md-4 offset-md-2 text-right">
						<a asp-action="Index" class="btn btn-outline-info form-control btn-sm">Back to Orders</a>
					</div>
				</div>
			</div>
			<div class="card-body">
				<div class="container rounded p-2">
					<div class="row">
						<div class="col-12 col-lg-6 pb-4">
							<div class="row">
								<h4 class="d-flex justify-content-between align-items-center mb-3">
									<span class="text-primary"> Details:</span>
								</h4>
							</div>
							<div class="row my-1">
								<div class="col-3">Name</div>
								<div class="col-9">
									@if (User.IsInRole(SD.Role_Admin))
									{
										<input asp-for="BookingHeder.Name" type="text" class="form-control" />
										<span asp-validation-for="BookingHeder.Name" class="text-danger"></span>
									}
									else
									{
										<input asp-for="BookingHeder.Name" readonly type="text" class="form-control" />
									}
								</div>
							</div>
							<div class="row my-1">
								<div class="col-3">Phone</div>
								<div class="col-9">
									@if (User.IsInRole(SD.Role_Admin))
									{
										<input asp-for="BookingHeder.PhoneNumber" type="text" class="form-control" />
										<span asp-validation-for="BookingHeder.PhoneNumber" class="text-danger"></span>
									}
									else
									{
										<input asp-for="BookingHeder.PhoneNumber" readonly type="text" class="form-control" />
									}
								</div>
							</div>
							<div class="row my-1">
								<div class="col-3">Address</div>
								<div class="col-9">
									@if (User.IsInRole(SD.Role_Admin))
									{
										<input asp-for="BookingHeder.Address" type="text" class="form-control" />
										<span asp-validation-for="BookingHeder.Address" class="text-danger"></span>
									}
									else
									{
										<input asp-for="BookingHeder.Address" readonly type="text" class="form-control" />
									}
								</div>
							</div>
							<div class="row my-1">
								<div class="col-3">City</div>
								<div class="col-9">
									@if (User.IsInRole(SD.Role_Admin) )
									{
										<input asp-for="BookingHeder.City" type="text" class="form-control" />
										<span asp-validation-for="BookingHeder.City" class="text-danger"></span>
									}
									else
									{
										<input asp-for="BookingHeder.City" readonly type="text" class="form-control" />
									}
								</div>
							</div>
							<div class="row my-1">
								<div class="col-3">State</div>
								<div class="col-9">
									@if (User.IsInRole(SD.Role_Admin))
									{
										<input asp-for="BookingHeder.District" type="text" class="form-control" />
										<span asp-validation-for="BookingHeder.District" class="text-danger"></span>
									}
									else
									{
										<input asp-for="BookingHeder.District" readonly type="text" class="form-control" />
									}
								</div>
							</div>
							<div class="row my-1">
								<div class="col-3">Zip Code</div>
								<div class="col-9">
									@if (User.IsInRole(SD.Role_Admin))
									{
										<input asp-for="BookingHeder.PostalCOde" type="text" class="form-control" />
										<span asp-validation-for="BookingHeder.PostalCOde" class="text-danger"></span>
									}
									else
									{
										<input asp-for="BookingHeder.PostalCOde" readonly type="text" class="form-control" />
									}
								</div>
							</div>
							<div class="row my-1">
								<div class="col-3">Email</div>
								<div class="col-9">
									<input asp-for="BookingHeder.ApplicationUser.Email" readonly type="text" class="form-control" />
								</div>
							</div>
							@* <div class="row my-1">
								<div class="col-3">Order Date</div>
								<div class="col-9">

									<input value="@Model.BookingHeder.EventDate.ToShortDateString()" readonly type="text" class="form-control" />

								</div>
							</div> *@
							
							<div class="row my-1">
								<div class="col-3">Warking Date</div>
								<div class="col-9">
									<input value="@Model.BookingHeder.EventDate.ToShortDateString()" type="text" readonly class="form-control" />
								</div>
							</div>
							@if (User.IsInRole(SD.Role_Admin))
							{
								<div class="row my-1">
									<div class="col-3">Session ID</div>
									<div class="col-9">
										<input asp-for="BookingHeder.SessionId" type="text" readonly class="form-control" />
									</div>
								</div>
								<div class="row my-1">
									<div class="col-3">Payment Intent ID</div>
									<div class="col-9">
										<input asp-for="BookingHeder.PaymentIntetId" type="text" readonly class="form-control" />
									</div>
								</div>
							}
							<div class="row my-1">
								@if (Model.BookingHeder.SessionId == null)
								{
									<div class="col-3">Payment Due Date</div>
									<div class="col-9">
										<input value="@Model.BookingHeder.PaymentDueDate.ToShortDateString()"
											   readonly type="text" class="form-control" />
									</div>
								}
								else
								{
									<div class="col-3">Payment Date</div>
									<div class="col-9">
										<input value="@Model.BookingHeder.PaymentDate.ToShortDateString()"
											   readonly id="paymentDate" type="text" class="form-control" />
									</div>
								}
							</div>
							<div class="row my-1">
								<div class="col-3">Payment Status</div>
								<div class="col-9">
									<input asp-for="BookingHeder.PaymentStatus" type="text" readonly class="form-control" />
								</div>
							</div>
							<input type="submit" asp-action="UpdateOrderDetail" class="btn btn-warning form-control my-1" value="Update Order Details" />



						</div>
						<div class="col-12 col-lg-5 offset-lg-1">
							<h4 class="d-flex justify-content-between align-items-center mb-3">
								<span class="text-primary">Order Summary</span>
							</h4>
							<label class="btn btn-outline-primary form-control my-2">Order Status - @Model.BookingHeder.BookingStatus</label>

							<ul class="list-group mb-3">
								@foreach (var detail in Model.BookingDetails)
								{
									<li class="list-group-item d-flex justify-content-between p-2">
										<div class="row container">
											<div class="col-8">

												<h6 class="my-0 text-primary">@detail.Packege.Name</h6>
												<small class="text-muted">Price : @detail.Price.ToString("c")</small><br />
												<small class="text-muted">Days : @detail.Days</small>
											</div>
											<div class="col-4 text-end">
												<p class="text-success">@((detail.Days * detail.Price).ToString("c"))</p>
											</div>
										</div>
									</li>
								}
								<li class="list-group-item bg-info">
									<div class="row container">
										<div class="col-6">
											<h5 class="text-white">TOTAL </h5>
										</div>
										<div class="col-6 text-end">
											<h5 class="text-white">@Model.BookingHeder.BookingTotal.ToString("c")</h5>
										</div>
									</div>
								</li>
							</ul>
							
							@if (User.IsInRole(SD.Role_User))
							{
								@if (Model.BookingHeder.PaymentStatus == SD.PaymentStatusDelayedPayment &&
										Model.BookingHeder.BookingStatus == SD.StatusCompleteEvent)
								{
									<input type="submit" class="btn btn-success form-control my-1" value="Pay Now" />
								}
							}

							

							@if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Photographer))
							{
								if (Model.BookingHeder.BookingStatus == SD.StatusApprove)
								{
									<input type="submit" asp-action="Attend" class="btn btn-primary form-control my-1" value="Approved" />
								}
								if (Model.BookingHeder.BookingStatus == SD.StatusInProcess)
								{
									<input type="submit" onclick="return validateInput()" asp-action="Complete" class="btn btn-primary form-control my-1" value="Complete the work" />
								}
							}
							
							@if (Model.BookingHeder.BookingStatus != SD.StatusRefunded &&
									Model.BookingHeder.BookingStatus != SD.StatusCancelled &&
									Model.BookingHeder.BookingStatus != SD.StatusCompleteEvent)
							{
								<input type="submit" asp-action="CancleBooking" class="btn btn-danger form-control my-1" value="Cancel Order" />
							}
							

						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>

