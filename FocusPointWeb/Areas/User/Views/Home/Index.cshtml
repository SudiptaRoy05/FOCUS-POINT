@model FocusPoint.Models.ViewModel.HomeVM


<div class="container">
    <div class="py-2">
        <form class="row" method="get" asp-controller="Home" asp-action="Search">
            <div class="col-6">
                <input class="form-control" type="text" name="query" placeholder="Enter name or category" />
            </div>
            <div class="col-6">
                <button class="form-control btn btn-primary" type="submit">Search</button>
            </div>
        </form>
    </div>
    @if (Model.MediaItems.Any())
    {
        <div class="row">
            @foreach (var item in Model.MediaItems)
            {
                @if (item.IsPublic == true)
                {
                    @if (item.Type == MediaItem.MediaType.Photograph)
                    {
                        <div id="image" class="col-lg-3 col-md-6">
                            <div class="row p-2">
                                <div class="col-12 p-1" style="border:1px solid #008cba; border-radius:5px">
                                    <div class="card">
                                        <img src="@item.Thumbnail1" class="card-img-top rounded" />
                                        <div class="card-body row">
                                            <div class="ps-1 col-6">
                                                <p class="card-title h5 text-dark">@item.FileName</p>
                                            </div>
                                            <div class="ps-1 col-6">
                                                <p class="card-title h5 text-dark">Price : @item.Price</p>
                                            </div>
                                        </div>
                                        <a asp-action="Details" asp-controller="Gallery" class="btn btn-primary form-control" asp-route-mediaItemId="@item.Id">
                                            Details
                                        </a>

                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div id="video" class="col-lg-3 col-md-6">
                            <div class="row p-2">
                                <div class="col-12 p-1" style="border:1px solid #008cba; border-radius:5px">
                                    <div class="card">
                                        @* <img src="@mediaItem.FileUrl" class="card-img-top rounded" /> *@
                                        <video width="240" height="160" class="card-img-top rounded" controls>
                                            <source src="@item.FileUrl">
                                        </video>
                                        <div class="card-body row">
                                            <div class="ps-1 col-6">
                                                <p class="card-title h5 text-dark">@item.FileName</p>
                                            </div>
                                            <div class="ps-1 col-6">
                                                <p class="card-title h5 text-dark">Price : @item.Price ৳</p>
                                            </div>
                                        </div>
                                        <a asp-action="Details" class="btn btn-primary form-control" asp-route-mediaItemId="@item.Id">
                                            Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }

            }
        </div>
    }


    @if (Model.Packeges.Any())
    {
        <div class="row">

        </div>
        @foreach (var package in Model.Packeges)
        {
            <div class="container mt-5">
                <div class="row">
                    <div class="col-md-6 mb-1">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title text-primary">@package.Name</h4>
                                <p class="card-text text-primary"><strong>Upload Date:</strong> @package.CreatedDateTime</p>
                            </div>
                            <img src="@package.FileUrl" class="card-img-top" alt="@package.Name">

                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title text-primary">Package Details</h4>
                                <p class="card-text text-primary"><strong>Photographer : </strong> @package.ApplicationUser.Name</p>
                                <p class="card-text text-primary"><strong>Price:</strong> @package.Price.ToString("0.00") BDT</p>
                                <div class="d-flex justify-content-between">
                                    <p class="card-text text-primary"><strong>3Days-6Days:</strong> @package.Price3.ToString("0.00") BDT</p>
                                    <p class="card-text text-primary"><strong>7Days-10Days:</strong> @package.Price6.ToString("0.00") BDT</p>
                                    <p class="card-text text-primary"><strong>10Days+:</strong> @package.Price10.ToString("0.00") BDT</p>
                                </div>
                                <p class="card-text text-primary"><strong>Description:</strong></p>
                                <p class="card-text text-primary">@Html.Raw(package.Description)</p>
                                <div class="d-flex justify-content-between align-items-center">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class=" row mt-3 mx-1">

                    <a asp-action="Details" asp-controller="PhotographyPackege" asp-route-packegeId="@package.Id" class="btn btn-info form-control">Details</a>
                </div>
            </div>
        
        }




    }
    @if (!Model.MediaItems.Any() && !Model.Packeges.Any())
    {
        <h3 class="text-bg-info">Not Found</h3>
    }


</div>
    

   
