@model IEnumerable<Packege>
@{
    ViewData["Title"] = "Index";
}



<section class="py-3 pb-5">

    <div class="form-control bg-primary">
        <h2 class="text-center text-white text-uppercase  py-3">Packege</h2>
    </div>
    @* <div class="text-center">
    <button type="button" id="toggleButton" class="btn btn-primary">Toggle</button>

    </div> *@
    <div class="py-2">
        <form class="row" method="get" asp-controller="PhotographyPackege" asp-action="Search">
            <div class="col-6">
                <input class="form-control" type="text" name="query" placeholder="Enter name or category" />
            </div>
            <div class="col-6">
                <button class="form-control btn btn-primary" type="submit">Search</button>
            </div>
        </form>
    </div>
    

    @if (Model.Any())
    {
        <div class="container mt-5">
            @foreach (var item in Model)
            {
                <div class="row card-header mx-2 my-2">
                    <div class="col-md-4">
                        <img src="@item.FileUrl" class="img-fluid rounded">
                    </div>

                    <div class="col-md-8 card-body">
                        <h4 class="mb-3 text-primary"> Name:@item.Name </h4>

                        <h4 class="mb-3 text-primary"> Photographer Name:@item.ApplicationUser.Name </h4>

                        <p class="text-primary"><strong>Upload Date: </strong>@item.CreatedDateTime</p>
                        <h2 class="text-primary"><strong>Price: </strong>@item.Price.ToString("0.00") BDT</h2>

                        <div class="">
                            <p class="">
                                <strong class="text-primary">Description: </strong> <span class="text-primary">@Html.Raw(item.Description)</span>
                            </p>
                        </div>
                    </div>
                    <div class="row my-2 py-2">
                        <div class="col-6">
                            <a asp-action="Profile" asp-controller="Photographer" asp-route-Id="@item.ApplicationUserId" class="btn btn-primary form-control -2">View Profile</a>
                        </div>
                        <div class="col-6">
                            <a asp-action="Details" class="btn btn-info form-control" asp-route-packegeId="@item.Id">
                                Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }


</section>