@model FocusPoint.Models.ViewModel.HireVM;


<form method="post" class="pb-5">
    <br />
    <div class="card shadow border-0">
        <div class="card-header bg-primary bg-gradient text-light ml-0 py-4">
            <div class="row px-4">
                <div class="col-6">
                    <h5 class="pt-2 text-white">
                        Booking Photographer
                    </h5>
                </div>

            </div>
        </div>
        <div class="card-body my-4 ms-2">
            <div class="row">
            </div>
            <div class="row mb-3 pb-3">
                <div class="col-md-2 offset-md-1">
                    <a class="btn btn-outline-primary text-uppercase mb-5 btn-sm" asp-area="User" asp-controller="PhotographyPackege" asp-action="Index"><small>View Packege</small></a>
                </div>
                <div class="col-md-10 offset-md-1">
                    @foreach (var item in Model.ListHire)
                    {

                        <div class="row border-bottom pb-3">
                            <div class="d-none d-lg-block col-lg-2 text-center py-2">
                                <img src="@item.Packege.FileUrl" class="rounded" width="100px" />
                            </div>
                            <div class="col-12 col-lg-4 pt-md-3">
                                
                                <div class="ms-lg-4">
                                    <!-- Adjust margin start (left margin for right column) -->
                                    <h5 class="text-uppercase text-primary"><strong>@item.Packege.Name</strong></h5>
                                    @* <h5 class="text-uppercase text-primary"><strong>@item.Packege.ApplicationUser.Name</strong></h5> *@
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 text-center row">
                                <div class="col-4 text-md-right pt-4">
                                    <h6>
                                        <strong>
                                            @item.Price.ToString(".00")
                                            <span class="text-muted">&nbsp;x&nbsp;</span>@item.Days
                                        </strong>
                                    </h6>
                                </div>
                                <div class="col-4 col-sm-4 col-lg-4 pt-2">
                                    <div class="w-75 btn-group" role="group">
                                        <a asp-action="plus" asp-route-hireId="@item.Id" class="btn btn-primary">
                                            <i class="bi bi-plus-square"></i>
                                        </a> &nbsp;
                                        <a asp-action="minus" asp-route-hireId="@item.Id" class="btn btn-warning">
                                            <i class="bi bi-dash-square"></i>
                                        </a>
                                    </div>

                                </div>
                                <div class="col-3 col-sm-4 col-lg-2 offset-lg-1 text-right pt-2">
                                    <a asp-action="Remove" asp-route-hireId="@item.Id" class="btn btn-danger bg-gradient py-2">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </div>
                            </div>
                        </div>


                    }

                </div>
            </div>
            <div class="card-footer bg-white border-0">
                <div class="row">
                    <div class="col-md-4 offset-md-4">
                        <ul class="list-group mb-4">
                            <li class="d-flex justify-content-between align-items-center">
                                <h4 class="text-dark fw-bolder">Total : @Model.BookingHeder.BookingTotal.ToString(".00") BDT</h4> 
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2 offset-md-5">
                        <a asp-action="Summary" asp-controller="Hire" class="btn btn-primary border-0 bg-gradient w-100 py-2">Summary</a>
                    </div>
                </div>
            </div>
        </div>
</form>
