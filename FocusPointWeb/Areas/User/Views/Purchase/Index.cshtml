 @model dynamic

<div class="container row">

    @foreach (var item in Model)
    {
        <div id="image" class="col-lg-3 col-md-6">
            <div class="row p-2">
                <div class="col-12 p-1" style="border:1px solid #008cba; border-radius:5px">
                    <div class="card">
                        <a href="@item.MediaItemFileUrl" download>
                            <img src="@item.MediaItemFileUrl" class="card-img-top rounded" style="cursor: pointer;" />
                        </a>
                        <div class="card-body row">
                            <div class="ps-1 col-6">
                                <p class="card-title h5 text-dark">@item.MediaItemName</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

