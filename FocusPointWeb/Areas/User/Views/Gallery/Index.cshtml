@model IEnumerable<MediaItem>




<section class="py-3 pb-5">
    <div class="form-control bg-primary">
        <h2 class="text-center text-white text-uppercase  py-3">Gallery</h2>
    </div>
    @* <div class="text-center">
        <button type="button" id="toggleButton" class="btn btn-primary">Toggle</button>
       
    </div> *@
    <div class="py-2">
        <form class="row" method="get" asp-controller="Gallery" asp-action="Search">
            <div class="col-6">
                <input class="form-control" type="text" name="query" placeholder="Enter name or category" />
            </div>
            <div class="col-6">
                <button class="form-control btn btn-primary" type="submit">Search</button>
            </div>
        </form>
    </div>
    <!-- Gallery -->
    
    @if (Model.Any())
    {
        <div class="row">
            @foreach (var mediaItem in Model)
            {
                @if (mediaItem.IsPublic == true)
                {
                    @if (mediaItem.Type == MediaItem.MediaType.Photograph)
                    {
                        <div id="image" class="col-lg-3 col-md-6">
                            <div class="row p-2">
                                <div class="col-12 p-1" style="border:1px solid #008cba; border-radius:5px">
                                    <div class="card">
                                        <img src="@mediaItem.Thumbnail1" class="card-img-top rounded" />
                                        <div class="card-body row">
                                            <div class="ps-1 col-6">
                                                <p class="card-title h5 text-dark">@mediaItem.FileName</p>
                                            </div>
                                            <div class="ps-1 col-6">
                                                <p class="card-title h5 text-dark">Price : @mediaItem.Price</p>
                                            </div>
                                        </div>
                                        <a asp-action="Details" class="btn btn-primary form-control" asp-route-mediaItemId="@mediaItem.Id">
                                            Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                    }
                    else
                    {
                        <div id="video" class="col-lg-3 col-md-6">
                            <div class="row p-2">
                                <div class="col-12 p-1" style="border:1px solid #008cba; border-radius:5px">
                                    <div class="card">
                                        @* <img src="@mediaItem.FileUrl" class="card-img-top rounded" /> *@
                                        <video width="240" height="160" class="card-img-top rounded" controls>
                                            <source src="@mediaItem.FileUrl">
                                        </video>
                                        <div class="card-body row">
                                            <div class="ps-1 col-6">
                                                <p class="card-title h5 text-dark">@mediaItem.FileName</p>
                                            </div>
                                            <div class="ps-1 col-6">
                                                <p class="card-title h5 text-dark">Price : @mediaItem.Price</p>
                                            </div>
                                        </div>
                                        <a asp-action="Details" class="btn btn-primary form-control" asp-route-mediaItemId="@mediaItem.Id">
                                            Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                      
                    }

                   
                }
               
            }
        </div>
    }
    else
    {
        <h2 class="text-info">Not Found</h2>
    }

    <!-- Gallery -->
</section>

@section Scripts{

  
    
    <script>
        $(document).ready(function() {
            $('#toggleButton').click(function() {
                $('#image').toggle();
                $('#video').toggle();
            });
        });
    </script>

